[Unit]
Description=Ripcars Verifier
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=notify
NotifyAccess=main
User=ripcars-verifier
Group=ripcars-bots
UMask=0007
WorkingDirectory=/opt/ripcars-verifier/current
EnvironmentFile=/etc/ripcars-verifier.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ripcars-verifier/current/.venv/bin/python main.py
Restart=on-failure
RestartSec=10
WatchdogSec=90
TimeoutStartSec=180
TimeoutStopSec=40
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/ripcars-verifier /var/lib/ripcars-bots
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=4096
MemoryMax=512M

[Install]
WantedBy=multi-user.target
